{
  "specialty": "Stroke",
  "title": "Dystonia Assessment",
  "description": "Stroke dystonia assessment.",
  "schema": {
    "sections": [
      {
        "title": "Social History and Home Environment",
        "hideReportTitle": true,
        "questions": [
          {
            "id": "attendance_mobility",
            "label": "Attendance and mobility",
            "type": "composite",
            "width": "full",
            "hideLabel": true,
            "customReport": "attendance_mobility",
            "parts": [
              {
                "id": "come_with",
                "label": "Come with",
                "placeholder": "family / carer",
                "wide": true,
                "showIf": {
                  "itemId": "come_alone",
                  "notEquals": true
                }
              },
              {
                "id": "come_alone",
                "label": "Come alone",
                "inputType": "checkbox",
                "suffix": ";"
              },
              {
                "id": "walk_with",
                "label": "Walk",
                "placeholder": "stick / rollator / frame",
                "wide": true,
                "showIf": {
                  "itemId": "on_wheelchair",
                  "notEquals": true
                }
              },
              {
                "id": "on_wheelchair",
                "label": "On wheelchair",
                "inputType": "checkbox"
              }
            ]
          },
          {
            "id": "review_period",
            "label": "Review period",
            "type": "multiple_choice",
            "width": "full",
            "reportTitle": " ",
            "reportHideTitle": true,
            "reportTemplate": "Review period: {answer}",
            "options": [
              "Baseline",
              "Post op",
              "Post op 1-month",
              "Post op 6-month",
              "Post op 12-month"
            ]
          },
          {
            "id": "lives_with",
            "label": "Living arrangement",
            "type": "checkbox",
            "width": "full",
            "reportTitle": "Social History and Home Environment",
            "options": [
              {
                "value": "Live with",
                "detail": true,
                "detailPlaceholder": "family / carer"
              },
              "Live alone",
              "Day time alone",
              "OAHR"
            ],
            "allowOther": true,
            "allowComment": true,
            "commentLabel": "Main carer / details",
            "customReport": "social_lives_home"
          },
          {
            "id": "home_access",
            "label": "Home environment",
            "type": "multiple_choice",
            "width": "half",
            "options": [
              "Direct lift landing",
              {
                "value": "Non-direct lift landing",
                "detail": true,
                "detailPlaceholder": "FOS / floor"
              },
              {
                "value": "No lift",
                "detail": true,
                "detailPlaceholder": "FOS / floor"
              }
            ],
            "allowComment": true,
            "commentLabel": "Floor / stairs detail",
            "hideInReport": true
          },
          {
            "id": "bathing_setup",
            "label": "Bathing",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Tub",
              "Shower",
              "Hot water system"
            ],
            "allowOther": true,
            "customReport": "bathing_combo"
          },
          {
            "id": "bath_method",
            "label": "Bath by",
            "type": "multiple_choice",
            "width": "full",
            "mergeUp": true,
            "options": [
              "Stand",
              "Squat",
              {
                "value": "Sit on",
                "subOptions": [
                  "Shower chair",
                  "Bath board",
                  "Shower stool"
                ],
                "subAllowOther": true
              },
              "Bedbath"
            ],
            "hideInReport": true
          },
          {
            "id": "social_service",
            "label": "Social support",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Nil",
              "MOW",
              {
                "value": "Home Help Service",
                "subOptions": [
                  "Personal care",
                  "Household",
                  "Escort"
                ],
                "subAllowOther": true
              },
              "Day Care Centre",
              "Elderly Centre"
            ],
            "allowOther": true,
            "reportTemplate": "Social support: {answer}."
          },
          {
            "id": "financial",
            "label": "Financial",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Family support / saving",
              "Comprehensive Social Security Assistance",
              "Disability Allowance",
              "Old Age Allowance",
              "Old Age Living Allowance"
            ],
            "allowOther": true,
            "reportTemplate": "Financial: {answer}."
          },
          {
            "id": "assistive_devices",
            "label": "Assistive device available",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Nil",
              "Stick",
              "Quadripod",
              "Frame",
              "Rollator",
              "Wheelchair",
              "Commode",
              "Shower chair",
              "Bath board",
              "Handrail",
              "Safety alarm"
            ],
            "allowOther": true,
            "reportTemplate": "Assistive device available: {answer}."
          }
        ],
        "reportTitle": "Social History and Home Environment"
      },
      {
        "title": "Premorbid Function",
        "questions": [
          {
            "id": "badl",
            "label": "BADL",
            "type": "multiple_choice",
            "width": "full",
            "options": [
              "Independent",
              "Assistance",
              "Dependent"
            ],
            "allowComment": true,
            "commentLabel": "Detail",
            "commentSingleLine": true,
            "commentPlaceholder": "add detail",
            "customReport": "essential_tremor_premorbid"
          },
          {
            "id": "functional_mobility",
            "label": "Functional Mobility",
            "type": "multiple_choice",
            "width": "half",
            "options": [
              "Unaided",
              "Assisted",
              "Dependent"
            ],
            "hideInReport": true
          },
          {
            "id": "functional_mobility_aid",
            "label": "Aids",
            "type": "checkbox",
            "width": "half",
            "mergeUp": true,
            "options": [
              "Stick",
              "Quadripod",
              "Frame",
              "Rollator"
            ],
            "allowOther": true,
            "otherPlaceholder": "walking aid",
            "hideInReport": true
          },
          {
            "id": "outdoor_function",
            "label": "Outdoor",
            "type": "multiple_choice",
            "width": "full",
            "options": [
              "Independent",
              "Assistance",
              "Dependent"
            ],
            "allowComment": true,
            "commentLabel": "Detail",
            "commentSingleLine": true,
            "commentPlaceholder": "add detail",
            "hideInReport": true
          },
          {
            "id": "iadl",
            "label": "IADL",
            "type": "multiple_choice",
            "width": "full",
            "options": [
              "Independent",
              "Assistance",
              "Dependent"
            ],
            "allowComment": true,
            "commentLabel": "Detail",
            "commentSingleLine": true,
            "commentPlaceholder": "add detail",
            "hideInReport": true
          },
          {
            "id": "life_role",
            "label": "Life Role",
            "type": "multiple_choice",
            "width": "full",
            "options": [
              {
                "value": "Retired",
                "detail": true,
                "detailPlaceholder": "previous role",
                "detailJoiner": " "
              },
              {
                "value": "Unemployed",
                "detail": true,
                "detailPlaceholder": "details",
                "detailJoiner": " "
              },
              {
                "value": "Employed",
                "detail": true,
                "detailPlaceholder": "occupation",
                "detailJoiner": " "
              }
            ],
            "allowOther": true,
            "hideInReport": true
          },
          {
            "id": "dominant_hand",
            "label": "Dominant hand",
            "type": "multiple_choice",
            "width": "half",
            "options": [
              "Right",
              "Left"
            ],
            "hideInReport": true
          },
          {
            "id": "fall_history_recent",
            "label": "History of Fall in recent year",
            "type": "multiple_choice",
            "width": "half",
            "options": [
              "Nil",
              {
                "value": "Number of fall",
                "detail": true,
                "detailPlaceholder": "number"
              }
            ],
            "allowComment": true,
            "commentLabel": "Detail",
            "commentSingleLine": true,
            "commentPlaceholder": "fall detail",
            "hideInReport": true
          },
          {
            "id": "leisure",
            "label": "Leisure",
            "type": "long_text",
            "width": "full",
            "hideInReport": true
          }
        ],
        "reportTitle": "B. Premorbid Function"
      },
      {
        "title": "General Assessment",
        "questions": [
          {
            "type": "heading",
            "label": "Mental and Cognitive Function"
          },
          {
            "id": "mental_state",
            "label": "Mental state",
            "type": "multiple_choice",
            "width": "half",
            "options": [
              "Alert",
              "Dull",
              "Confused"
            ],
            "customReport": "essential_tremor_mental"
          },
          {
            "id": "follow_cmd_quality",
            "label": "Follow command",
            "type": "multiple_choice",
            "width": "half",
            "mergeUp": true,
            "options": [
              "Good",
              "Fair",
              "Poor"
            ],
            "hideInReport": true
          },
          {
            "id": "follow_cmd_steps",
            "label": "Step command",
            "type": "multiple_choice",
            "width": "full",
            "mergeUp": true,
            "options": [
              "1 step",
              "2 step",
              "3 step"
            ],
            "hideInReport": true
          },
          {
            "id": "speech",
            "label": "Speech",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Normal",
              "Expressive dysphasia",
              "Receptive dysphasia",
              "Dysarthria"
            ]
          },
          {
            "id": "cog_status",
            "label": "Cognition assessment",
            "type": "heading",
            "width": "full",
            "hideInReport": true
          },
          {
            "id": "moca",
            "label": "HK-Montreal Cognitive Assessment (MoCA)",
            "type": "sub_score",
            "mode": "max",
            "totalMax": 30,
            "width": "full",
            "breakdownItemsPerLine": 4,
            "breakdownSep": "   ",
            "customReport": "essential_tremor_moca",
            "headerInputs": [
              {
                "id": "moca_age_cluster",
                "label": "Age",
                "type": "select",
                "placeholder": "Select age",
                "options": [
                  "65-69",
                  "70-79",
                  "≥80"
                ]
              },
              {
                "id": "moca_education",
                "label": "Education",
                "type": "number",
                "inputType": "number",
                "placeholder": "Years",
                "min": 0,
                "step": 1
              }
            ],
            "items": [
              {
                "id": "executive_function",
                "label": "Executive Function",
                "max": 5
              },
              {
                "id": "naming",
                "label": "Naming",
                "max": 3
              },
              {
                "id": "attention",
                "label": "Attention",
                "max": 6
              },
              {
                "id": "language",
                "label": "Language",
                "max": 3
              },
              {
                "id": "abstraction",
                "label": "Abstraction",
                "max": 2
              },
              {
                "id": "delayed_recall",
                "label": "Delayed Recall",
                "max": 5
              },
              {
                "id": "orientation",
                "label": "Orientation",
                "max": 6
              }
            ]
          },
          {
            "id": "moca_band",
            "label": "MoCA percentile",
            "type": "multiple_choice",
            "width": "full",
            "mergeUp": true,
            "hideInForm": true,
            "options": [
              ">16th percentile",
              "<=16th percentile: DSM-5 minor NCD",
              "<=7th percentile: Petersen MCI",
              "<=2nd percentile: DSM-5 major NCD"
            ],
            "hideInReport": true
          },
          {
            "id": "major_complaint",
            "label": "Major complaint",
            "type": "short_text",
            "width": "full",
            "customReport": "essential_tremor_major_complaint"
          },
          {
            "type": "heading",
            "label": "Physical Assessment"
          },
          {
            "id": "power",
            "label": "Power",
            "type": "composite",
            "layout": "grid-2x2",
            "width": "half",
            "rowHeaders": [
              "Upper",
              "Lower"
            ],
            "colHeaders": [
              "Right",
              "Left"
            ],
            "parts": [
              {
                "id": "rul",
                "placeholder": "5"
              },
              {
                "id": "lul",
                "placeholder": "5"
              },
              {
                "id": "rll",
                "placeholder": "5"
              },
              {
                "id": "lll",
                "placeholder": "5"
              }
            ],
            "customReport": "essential_tremor_power"
          },
          {
            "id": "tone",
            "label": "Tone",
            "type": "multiple_choice",
            "width": "half",
            "options": [
              "NAD"
            ],
            "allowOther": true,
            "keepOtherLabel": true,
            "otherPlaceholder": "describe"
          },
          {
            "id": "coordination",
            "label": "Coordination",
            "type": "multiple_choice",
            "width": "half",
            "mergeUp": true,
            "options": [
              "NAD"
            ],
            "allowOther": true,
            "keepOtherLabel": true,
            "otherPlaceholder": "describe"
          },
          {
            "id": "balance_sitting_static",
            "label": "Balance - Sitting static",
            "type": "checkbox",
            "width": "half",
            "options": [
              "Good",
              "Fair",
              "Poor"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "customReport": "essential_tremor_balance"
          },
          {
            "id": "balance_sitting_dynamic",
            "label": "Balance - Sitting dynamic",
            "type": "checkbox",
            "width": "half",
            "mergeUp": true,
            "options": [
              "Good",
              "Fair",
              "Poor"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "hideInReport": true
          },
          {
            "id": "balance_standing_static",
            "label": "Balance - Standing static",
            "type": "checkbox",
            "width": "half",
            "options": [
              "Good",
              "Fair",
              "Poor"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "hideInReport": true
          },
          {
            "id": "balance_standing_dynamic",
            "label": "Balance - Standing dynamic",
            "type": "checkbox",
            "width": "half",
            "mergeUp": true,
            "options": [
              "Good",
              "Fair",
              "Poor"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "hideInReport": true
          },
          {
            "id": "transfer_level",
            "label": "Transfer",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Independent",
              "Supervision",
              "Mild Assistance",
              "Moderate Assistance",
              "Maximal Assistance",
              "Dependent"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "reportTemplate": "Transfer: {answer}"
          },
          {
            "id": "ambulation",
            "label": "Ambulation",
            "type": "checkbox",
            "width": "half",
            "options": [
              "Independent",
              "Supervision",
              "Mild Assistance",
              "Moderate Assistance",
              "Maximal Assistance",
              "Dependent"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "customReport": "ambulation_combo"
          },
          {
            "id": "ambulation_aid",
            "label": "Ambulation aid",
            "type": "multiple_choice",
            "width": "half",
            "mergeUp": true,
            "options": [
              "Stick",
              "Quadripod",
              "Frame",
              "Rollator"
            ],
            "allowOther": true,
            "otherPlaceholder": "specify",
            "hideInReport": true
          },
          {
            "id": "cervical_dystonia",
            "label": "Cervical dystonia",
            "type": "checkbox",
            "width": "full",
            "options": ["Torticollis", "Laterocollis", "Anterocollis", "Retrocollis"],
            "allowOther": true,
            "otherPlaceholder": "specify"
          },
          {
            "id": "pain_nprs",
            "label": "Pain",
            "type": "pain_nprs",
            "width": "full",
            "customReport": "pain_nprs_summary"
          },
          {
            "type": "heading",
            "label": "Functional Assessment"
          },
          {
            "id": "mbi",
            "label": "ADL: Modified Barthel Index",
            "type": "sub_score",
            "mode": "options",
            "totalMax": 100,
            "width": "full",
            "pendingPolicy": {
              "oneOfGroups": [
                [
                  "mobility",
                  "wheelchair"
                ]
              ],
              "pendingText": ", pending further assessment"
            },
            "includeNAInBreakdown": true,
            "breakdownPosition": "after",
            "breakdownItemsPerLine": 5,
            "breakdownSep": "   ",
            "combineItems": [
              {
                "ids": [
                  "mobility",
                  "wheelchair"
                ],
                "label": "Mobility/Wheelchair"
              }
            ],
            "items": [
              {
                "id": "bowels",
                "label": "Bowels",
                "options": [
                  0,
                  2,
                  5,
                  8,
                  10
                ],
                "allowNA": true,
                "defaultNA": true,
                "qualifier": {
                  "id": "mbi_bowels_stoma",
                  "label": "Stoma"
                }
              },
              {
                "id": "bladder",
                "label": "Bladder",
                "options": [
                  0,
                  2,
                  5,
                  8,
                  10
                ],
                "allowNA": true,
                "defaultNA": true,
                "qualifier": {
                  "id": "mbi_bladder_foley",
                  "label": "Foley"
                }
              },
              {
                "id": "grooming",
                "label": "Grooming",
                "options": [
                  0,
                  1,
                  3,
                  4,
                  5
                ],
                "allowNA": true,
                "defaultNA": true
              },
              {
                "id": "toileting",
                "label": "Toileting",
                "options": [
                  0,
                  2,
                  5,
                  8,
                  10
                ],
                "allowNA": true,
                "defaultNA": true
              },
              {
                "id": "feeding",
                "label": "Feeding",
                "options": [
                  0,
                  2,
                  5,
                  8,
                  10
                ],
                "allowNA": true,
                "defaultNA": true,
                "qualifier": {
                  "id": "mbi_feeding_rt",
                  "label": "R/T"
                }
              },
              {
                "id": "dressing",
                "label": "Dressing",
                "options": [
                  0,
                  2,
                  5,
                  8,
                  10
                ],
                "allowNA": true,
                "defaultNA": true
              },
              {
                "id": "bathing",
                "label": "Bathing",
                "options": [
                  0,
                  1,
                  3,
                  4,
                  5
                ],
                "allowNA": true,
                "defaultNA": true
              },
              {
                "id": "transfer",
                "label": "Transfer",
                "options": [
                  0,
                  3,
                  8,
                  12,
                  15
                ],
                "allowNA": true,
                "defaultNA": true
              },
              {
                "id": "mobility",
                "label": "Mobility",
                "options": [
                  0,
                  3,
                  8,
                  12,
                  15
                ],
                "allowNA": true,
                "defaultNA": true,
                "exclusiveWith": "wheelchair"
              },
              {
                "id": "wheelchair",
                "label": "Wheelchair",
                "options": [
                  0,
                  1,
                  3,
                  4,
                  5
                ],
                "allowNA": true,
                "defaultNA": true,
                "exclusiveWith": "mobility"
              },
              {
                "id": "stairs",
                "label": "Stairs",
                "options": [
                  0,
                  2,
                  5,
                  8,
                  10
                ],
                "allowNA": true,
                "defaultNA": true
              }
            ],
            "customReport": "essential_tremor_mbi_summary"
          },
          {
            "id": "lawton_iadl",
            "label": "IADL: Lawton IADL",
            "type": "sub_score",
            "mode": "options",
            "totalMax": 27,
            "width": "full",
            "customReport": "lawton_summary",
            "items": [
              {
                "id": "telephone",
                "label": "Use of telephone",
                "options": [
                  0,
                  1,
                  2,
                  3
                ]
              },
              {
                "id": "transportation",
                "label": "Transportation",
                "options": [
                  0,
                  1,
