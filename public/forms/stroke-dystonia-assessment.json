                "id": "medication_management",
                "label": "Medication Management",
                "options": [
                  0,
                  1,
                  2,
                  3
                ]
              },
              {
                "id": "money_management",
                "label": "Money Management",
                "options": [
                  0,
                  1,
                  2,
                  3
                ]
              }
            ]
          }
        ],
        "reportTitle": "Assessment",
        "hideReportTitle": true
      },
      {
        "title": "Mood Assessment",
        "questions": [
          {
            "id": "dass21",
            "label": "DASS-21",
            "type": "dass21_table",
            "width": "full",
            "customReport": "dass21_summary",
            "instructions": "填表說明：請小心閱讀以下每一個句子，並在其右方圈上一數字，表示「過往一個星期」如何適用於你。答案並無對錯之分。請不要花太多時間在某一句子上。",
            "scaleGuide": "評估量表：0 = 不適用  1 = 頗適用，或間中適用  2 = 很適用，或經常適用  3 = 最適用，或常常適用",
            "scoreNote": "Severity matched according to DASS severity ratings",
            "rows": [
              {
                "id": "q1",
                "number": 1,
                "label": "我覺得很難讓自己安靜下來",
                "domain": "S"
              },
              {
                "id": "q2",
                "number": 2,
                "label": "我感到口乾",
                "domain": "A"
              },
              {
                "id": "q3",
                "number": 3,
                "label": "我好像不能再有任何愉快、舒暢的感覺",
                "domain": "D"
              },
              {
