{
  "specialty": "NS",
  "title": "[Surgical] ERAS Assessment",
  "description": "Enhanced Recovery After Surgery occupational therapy assessment.",
  "schema": {
    "sections": [
      {
        "title": "Vital signs and Premorbid ADL",
        "reportTitle": "A. Vital signs and Premorbid ADL",
        "hideReportTitle": true,
        "questions": [
          { "type": "heading", "label": "Vital signs" },
          {
            "id": "vitals",
            "label": "Vital signs",
            "hideLabel": true,
            "type": "composite",
            "width": "full",
            "parts": [
              { "id": "bp", "label": "BP", "placeholder": "120/80", "suffix": " mmHg" },
              { "id": "pulse", "label": "Pulse", "placeholder": "78", "suffix": "/minute" },
              { "id": "spo2", "label": "SpO2", "placeholder": "98", "suffix": "%" },
              { "id": "oxygen", "label": "", "placeholder": "Room Air / L O2", "wide": true },
              { "id": "other", "label": "Other", "placeholder": "", "extraWide": true }
            ],
            "joinWith": "  ",
            "reportTemplate": "Vital signs: BP {bp} mmHg, Pulse {pulse}/minute, SpO2 {spo2}% {oxygen} {other}",
            "customReport": "vitals_summary"
          },
          { "type": "heading", "label": "Premorbid ADL" },
          {
            "id": "premorbid_badl", "label": "Basic ADL", "type": "checkbox", "width": "half",
            "options": [
              "Independent",
              { "value": "Independent up to", "detail": true, "detailPlaceholder": "details", "detailJoiner": " " },
              { "value": "Supervision in", "detail": true, "detailPlaceholder": "details", "detailJoiner": " " },
              { "value": "Assisted in", "detail": true, "detailPlaceholder": "details", "detailJoiner": " " },
              "Dependent"
            ],
            "customReport": "premorbid_adl"
          },
          {
            "id": "indoor_walk", "label": "Indoor mobility", "type": "multiple_choice", "width": "full",
            "options": ["Independent", "Supervision", "Assisted", "Dependent"],
            "hideInReport": true, "allowComment": true, "commentLabel": "Remark", "commentSingleLine": true
          },
          {
            "id": "indoor_aid", "label": "Indoor mobility aid", "type": "multiple_choice", "width": "full", "mergeUp": true,
            "options": ["Unaided", "Stick", "Quadripod", "Frame", "Rollator", "Trolley", "Chairbound", "Bedbound"],
            "allowOther": true, "otherPlaceholder": "specify", "hideInReport": true
          },
          {
            "id": "outdoor_walk", "label": "Outdoor mobility", "type": "multiple_choice", "width": "full",
            "options": ["Independent", "Supervision", "Assisted", "Dependent"],
            "hideInReport": true, "allowComment": true, "commentLabel": "Remark", "commentSingleLine": true
          },
          {
            "id": "outdoor_aid", "label": "Outdoor mobility aid", "type": "multiple_choice", "width": "full", "mergeUp": true,
            "options": ["Unaided", "Stick", "Quadripod", "Frame", "Rollator", "Trolley", "Wheelchair"],
            "allowOther": true, "otherPlaceholder": "specify", "hideInReport": true
          },
          {
            "id": "premorbid_iadl", "label": "IADL", "type": "checkbox", "width": "half",
            "options": ["Independent", "Supervision", "Assisted", "Dependent"], "hideInReport": true
          },
          { "id": "lawton_iadl", "label": "Lawton IADL (optional)", "type": "number", "width": "half", "min": 0, "max": 27, "placeholder": "__/27", "reportTemplate": "Lawton IADL: {answer}/27", "hideInReport": true },
          {
            "id": "occupation", "label": "Occupation", "type": "multiple_choice", "width": "half",
            "options": ["Retired"], "allowOther": true, "otherPlaceholder": "remarks", "hideInReport": true
          },
          {
            "id": "cfs", "label": "Clinical Frailty Scale (CFS)", "type": "select", "width": "full", "inlineControl": true,
            "placeholder": "Select CFS level",
            "options": [
              { "value": "1 — Very Fit", "label": "1 — Very Fit" },
              { "value": "2 — Fit", "label": "2 — Fit" },
              { "value": "3 — Managing Well", "label": "3 — Managing Well" },
              { "value": "4 — Vulnerable", "label": "4 — Vulnerable" },
              { "value": "5 — Mildly Frail", "label": "5 — Mildly Frail" },
              { "value": "6 — Moderately Frail", "label": "6 — Moderately Frail" },
              { "value": "7 — Severely Frail", "label": "7 — Severely Frail" },
              { "value": "8 — Very Severely Frail", "label": "8 — Very Severely Frail" },
              { "value": "9 — Terminally Ill", "label": "9 — Terminally Ill" }
            ],
            "customReport": "cfs_summary"
          }
        ]
      },
      {
        "title": "Social History and Home Environment",
        "reportTitle": "B. Social History and Home Environment",
        "hideQuestionsIf": {
          "questionId": "social_limited_sh",
          "equals": "Limited information from patient"
        },
        "questions": [
          {
            "id": "social_limited_sh", "label": "Limited information", "hideLabel": true,
            "type": "checkbox", "width": "full", "tickStyle": true,
            "options": ["Limited information from patient"],
            "reportTemplate": "Limited information from patient."
          },
          {
            "id": "lives_with", "label": "Lives with", "type": "checkbox", "width": "full",
            "options": [
              { "value": "Live with", "detail": true, "detailPlaceholder": "spouse / child / domestic helper" },
              "Live alone", "OAHR", "Hostel", "Day time alone", "Night time alone"
            ],
            "allowOther": true, "allowComment": true, "commentLabel": "Main carer / details",
            "customReport": "social_lives_home"
          },
          {
            "id": "home_access", "label": "Home access", "type": "multiple_choice", "width": "half",
            "options": [
              "Direct lift-landing",
              { "value": "Non-direct lift-landing", "subOptions": [], "subAllowOther": true },
              { "value": "No lift", "subOptions": [], "subAllowOther": true }
            ],
            "allowComment": true, "commentLabel": "Floor / stairs detail", "hideInReport": true
          },
          {
            "id": "bathing_setup", "label": "Bathing setup", "type": "checkbox", "width": "full",
            "options": ["Tub", "Shower", "Hot water system"], "allowOther": true,
            "customReport": "bathing_combo"
          },
          {
            "id": "bath_method", "label": "Bath by", "type": "multiple_choice", "width": "full", "mergeUp": true,
            "options": [
              "Stand", "Squat",
              { "value": "Sit on", "subOptions": ["Shower chair", "Bath board", "Shower stool"], "subAllowOther": true },
              "Bedbath"
            ],
            "hideInReport": true
          },
          {
            "id": "social_service", "label": "Social service", "type": "checkbox", "width": "full",
            "options": [
              "Nil",
              { "value": "Day Care centre", "detail": true, "detailPlaceholder": "name / frequency", "detailJoiner": " (", "detailSuffix": ")" },
              { "value": "Elderly Centre", "detail": true, "detailPlaceholder": "name / frequency", "detailJoiner": " (", "detailSuffix": ")" },
              { "value": "Respite Services", "detail": true, "detailPlaceholder": "name / frequency", "detailJoiner": " (", "detailSuffix": ")" },
              {
                "value": "Home Help Service",
                "subOptions": [
                  { "value": "Meal on wheels", "detail": true, "detailPlaceholder": "frequency" },
                  { "value": "Personal care", "detail": true, "detailPlaceholder": "frequency" },
                  { "value": "Household", "detail": true, "detailPlaceholder": "frequency" },
                  { "value": "Escort", "detail": true, "detailPlaceholder": "frequency" }
                ],
                "subAllowOther": true
              }
            ],
            "allowOther": true
          },
          {
            "id": "assistive_devices", "label": "Assistive devices", "type": "checkbox", "width": "full",
            "options": [
              "Nil", "Safety alarm", "Commode", "Handrail",
              { "value": "Walking aids", "subOptions": ["Stick", "Quadripod", "Frame", "Rollator"], "subAllowOther": true },
              "Wheelchair"
            ],
            "allowOther": true
          }
        ]
      },
      {
        "title": "Mental & Cognitive Function",
        "reportTitle": "C. Mental & Cognitive Function",
        "questions": [
          {
            "id": "gcs", "label": "GCS", "type": "composite", "width": "half",
            "parts": [
              { "id": "e", "label": "E", "placeholder": "1-4" },
              { "id": "v", "label": "V", "placeholder": "1-5" },
              { "id": "m", "label": "M", "placeholder": "1-6" }
            ],
            "joinWith": " ", "reportTemplate": "GCS: E{e} V{v} M{m}"
          },
          {
            "id": "mental_state", "label": "Mental state", "type": "multiple_choice", "width": "half",
            "options": ["Alert", "Confused", "Drowsy", "Stupor"],
            "allowComment": true, "commentSingleLine": true, "customReport": "mental_followcmd"
          },
          {
            "id": "follow_cmd", "label": "Follow command", "type": "checkbox", "width": "half",
            "options": ["1 step", "2 steps", "3 steps", "Not follow command"],
            "combineAdjacent": true, "maxSelect": 2, "consecutiveOnly": true,
            "allowComment": true, "commentSingleLine": true, "commentLabel": "Other", "hideInReport": true
          },
          {
            "id": "orientation", "label": "Orientated to", "type": "checkbox", "width": "half",
            "options": ["Name", "Time", "Place", "Person"], "invertedCheckbox": true,
            "unableToAssess": true, "customReport": "orientation_split"
          },
          {
            "id": "speech", "label": "Speech", "type": "checkbox", "width": "full",
            "options": ["Normal", "Expressive dysphasia", "Receptive dysphasia", "Dysarthria"],
            "allowOther": true
          },
          {
            "id": "cog_status", "label": "Pre-operative cognitive assessment", "type": "multiple_choice", "width": "full",
            "options": [
              "Performed",
              { "value": "Failed to assess due to", "detail": true, "detailPlaceholder": "reason (e.g. poor GCS)" },
              "Declined"
            ],
            "customReport": "preoperative_cog_status_header"
          },
          {
            "id": "moca", "label": "HK-Montreal Cognitive Assessment (MoCA)", "type": "sub_score", "mode": "max",
            "totalMax": 30, "required": true, "removable": true, "width": "full",
            "headerInputs": [
              { "id": "moca_age_cluster", "label": "Age", "type": "select", "placeholder": "Select age", "options": ["65-69", "70-79", "≥80"] },
              { "id": "moca_education", "label": "Education", "type": "number", "inputType": "number", "placeholder": "Years", "min": 0, "step": 1 }
            ],
            "items": [
              { "id": "visuospatial", "label": "Visuospatial / Executive", "max": 5 },
              { "id": "naming", "label": "Naming", "max": 3 },
              { "id": "attention", "label": "Attention", "max": 6 },
              { "id": "language", "label": "Language", "max": 3 },
              { "id": "abstraction", "label": "Abstraction", "max": 2 },
              { "id": "recall", "label": "Delayed Recall", "max": 5 },
              { "id": "orientation", "label": "Orientation", "max": 6 }
            ],
            "breakdownItemsPerLine": 5, "breakdownSep": "   ", "customReport": "moca_full",
            "showIf": { "questionId": "cog_status", "equals": "Performed" }
          },
          {
            "id": "moca_band", "label": "MoCA percentile", "type": "multiple_choice", "width": "full", "mergeUp": true,
            "hideInForm": true, "options": [">16th percentile", "≤16th percentile", "≤7th percentile", "≤2nd percentile"],
            "showIf": { "questionId": "cog_status", "equals": "Performed" }, "hideInReport": true
          },
          {
            "id": "cog_impression", "label": "Impression", "type": "short_text", "width": "full", "hideReportLabel": true,
            "showIf": { "questionId": "cog_status", "equals": "Performed" }
          },
          {
            "id": "other_cognitive_toggle", "label": "Other Cognitive Test", "type": "checkbox", "width": "full",
            "options": ["Show Other Cognitive Test"], "hideInReport": true,
            "showIf": { "questionId": "cog_status", "equals": "Performed" }
          },
          {
            "id": "amt", "label": "Abbreviated Mental Test (AMT)", "type": "sub_score", "mode": "options",
            "totalMax": 10, "required": true, "removable": true, "width": "full",
            "hint": "Cut-off 6/10. Score below cut-off indicates further evaluation for possible cognitive impairment.",
            "items": [
              { "id": "age", "label": "Age", "options": [0, 1] },
              { "id": "time", "label": "Time", "options": [0, 1] },
              { "id": "addr", "label": "Address for recall", "options": [0, 1] },
              { "id": "year", "label": "Current year", "options": [0, 1] },
              { "id": "place", "label": "Place", "options": [0, 1] },
              { "id": "recog", "label": "Recognition of two persons", "options": [0, 1] },
              { "id": "dob", "label": "Date of birth", "options": [0, 1] },
              { "id": "festival", "label": "Date of mid-Autumn festival", "options": [0, 1] },
              { "id": "leader", "label": "Name of present Governor / Chinese leader", "options": [0, 1] },
              { "id": "count_back", "label": "Count from 20 to 1 backwards", "options": [0, 1] }
            ],
            "reportTemplate": "Abbreviated Mental Test (AMT): {answer} (Cut off scores: <6 indicated further evaluations for possibility of cognitive impairment)",
            "breakdownItemsPerLine": 7, "breakdownSep": "   ",
            "showIf": { "questionId": "other_cognitive_toggle", "equals": "Show Other Cognitive Test" }
          },
          {
            "id": "cdt", "label": "Clock Drawing Test (CDT)", "type": "rating", "min": 0, "max": 10,
            "removable": true, "width": "full", "hint": "Cut-off 4. Lower score indicates lower cognitive function.",
            "reportTemplate": "Clock Drawing Test (CDT): {answer} (Cut off score: 3/4; Lower score indicated higher cognitive function)",
            "showIf": { "questionId": "other_cognitive_toggle", "equals": "Show Other Cognitive Test" }
          },
          {
            "id": "psychological_distress", "label": "Psychological Distress", "type": "multiple_choice", "width": "full",
            "options": [
              "No",
              { "value": "Yes", "detail": true, "detailPlaceholder": "remark", "detailJoiner": ": " }
            ]
          }
        ]
      },
      {
        "title": "Physical Assessment",
        "reportTitle": "D. Physical Assessment",
        "questions": [
          { "id": "pain", "label": "Pain at operation site", "type": "multiple_choice", "width": "half", "options": ["Nil", "Mild", "Moderate", "Severe"] },
          { "id": "pain_scores", "label": "Pain score", "type": "composite", "width": "half", "parts": [{ "id": "rest", "label": "NRS at rest", "placeholder": "/10" }, { "id": "movement", "label": "upon movement", "placeholder": "/10" }], "joinWith": ", ", "reportTemplate": "NRS: {rest}/10 at rest, {movement}/10 upon movement" },
          { "id": "analgesia", "label": "On", "type": "checkbox", "width": "full", "options": ["PCA", "Ketamine infusion", "EA"] },
          { "id": "swelling", "label": "Swelling", "type": "multiple_choice", "width": "half", "options": ["NAD", "Mild", "Moderate", "Severe"] },
          { "id": "swelling_location", "label": "location", "type": "short_text", "width": "half", "mergeUp": true, "hideInReport": true },
          { "id": "wound", "label": "Wound", "type": "checkbox", "width": "full", "options": ["On dressing", "On drain", "ESD"] },
          { "id": "power", "label": "Power", "type": "composite", "layout": "grid-2x2", "width": "half", "rowHeaders": ["Upper", "Lower"], "colHeaders": ["Right", "Left"], "parts": [{ "id": "rul", "placeholder": "5" }, { "id": "lul", "placeholder": "5" }, { "id": "rll", "placeholder": "5" }, { "id": "lll", "placeholder": "5" }], "reportTemplate": "Power:\n{rul} | {lul}\n{rll} | {lll}" },
          { "id": "balance_sit", "label": "Balance — Sitting", "type": "checkbox", "width": "half", "options": ["Good", "Fair", "Poor"], "combineAdjacent": true, "maxSelect": 2, "consecutiveOnly": true, "customReport": "balance_combo", "allowSuspend": true },
          { "id": "balance_stand", "label": "Balance — Standing", "type": "checkbox", "width": "half", "mergeUp": true, "options": ["Good", "Fair", "Poor"], "combineAdjacent": true, "maxSelect": 2, "consecutiveOnly": true, "hideInReport": true, "allowSuspend": true },
          { "id": "transfer_lie_sit", "label": "Transfer — Lie to sit", "type": "checkbox", "width": "half", "options": ["Independent", "Supervision", "Mild Assistance", "Moderate Assistance", "Maximal Assistance", "Dependent"], "combineAdjacent": true, "maxSelect": 2, "consecutiveOnly": true, "customReport": "transfer_combo", "allowSuspend": true },
          { "id": "transfer_sit_stand", "label": "Transfer — Sit to stand", "type": "checkbox", "width": "half", "mergeUp": true, "options": ["Independent", "Supervision", "Mild Assistance", "Moderate Assistance", "Maximal Assistance", "Dependent"], "combineAdjacent": true, "maxSelect": 2, "consecutiveOnly": true, "hideInReport": true, "allowSuspend": true },
          { "id": "ambulation", "label": "Ambulation", "type": "checkbox", "width": "half", "options": ["Independent", "Supervision", "Mild Assistance", "Moderate Assistance", "Maximal Assistance", "Dependent"], "combineAdjacent": true, "maxSelect": 2, "consecutiveOnly": true, "customReport": "ambulation_combo", "allowSuspend": true },
          { "id": "ambulation_aid", "label": "Ambulation aid", "type": "multiple_choice", "width": "half", "mergeUp": true, "options": ["Unaided", "Stick", "Quadripod", "Frame", "Rollator", "Wheelchair"], "allowOther": true, "otherPlaceholder": "specify", "hideInReport": true }
        ]
      },
      {
        "title": "Functional and Fall Assessment",
        "reportTitle": "E. Functional Assessment",
        "questions": [
          {
            "id": "mbi", "label": "Modified Barthel Index (MBI)", "type": "sub_score", "mode": "options", "totalMax": 100, "width": "full", "includeNAInBreakdown": true, "breakdownPosition": "after", "breakdownItemsPerLine": 5, "breakdownSep": "   ", "customReport": "mbi_summary",
            "items": [
              { "id": "bowels", "label": "Bowels", "options": [0, 2, 5, 8, 10], "allowNA": true },
              { "id": "bladder", "label": "Bladder", "options": [0, 2, 5, 8, 10], "allowNA": true },
              { "id": "grooming", "label": "Grooming", "options": [0, 1, 3, 4, 5], "allowNA": true },
              { "id": "toileting", "label": "Toileting", "options": [0, 2, 5, 8, 10], "allowNA": true },
              { "id": "feeding", "label": "Feeding", "options": [0, 2, 5, 8, 10], "allowNA": true },
              { "id": "dressing", "label": "Dressing", "options": [0, 2, 5, 8, 10], "allowNA": true },
              { "id": "bathing", "label": "Bathing", "options": [0, 1, 3, 4, 5], "allowNA": true },
              { "id": "transfer", "label": "Transfer", "options": [0, 3, 8, 12, 15], "allowNA": true },
              { "id": "mobility", "label": "Mobility", "options": [0, 3, 8, 12, 15], "allowNA": true },
              { "id": "stairs", "label": "Stairs", "options": [0, 2, 5, 8, 10], "allowNA": true }
            ]
          },
          {
            "id": "mbi_impression",
            "label": "Impression",
            "type": "short_text",
            "width": "full",
            "reportTemplate": "{answer}",
            "hideReportLabel": true
          },
          {
            "id": "mbi_overall",
            "label": "Overall functional level",
            "type": "checkbox",
            "width": "full",
            "options": [
              "Independent",
              "Supervision",
              "Mild Assistance",
              "Moderate Assistance",
              "Maximal Assistance",
              "Dependent"
            ],
            "combineAdjacent": true,
            "maxSelect": 2,
            "consecutiveOnly": true,
            "hideInReport": true
          },
          {
            "id": "fall_risk", "label": "Fall risk", "type": "multiple_choice", "width": "half",
            "customReport": "fall_assessment_compact",
            "options": ["No", { "value": "Yes", "subOptions": ["Low", "High"] }]
          },
          {
            "id": "fall_factors", "label": "Risk factors", "type": "checkbox", "width": "full",
            "options": ["Dizziness", "LL weakness", "Cognitive problem", "Gait disturbance", "History of fall", "Poor safety awareness"],
            "allowOther": true, "hideInReport": true,
            "showIf": { "questionId": "fall_risk", "equals": "Yes" }
          },
          { "id": "fall_history", "label": "Fall in recent year", "type": "yes_no", "width": "half", "hideInReport": true },
          {
            "id": "fall_freq", "label": "Fall frequency", "type": "short_text", "width": "half", "hideInReport": true,
            "hint": "e.g. 1 fall in 6 months",
            "showIf": { "questionId": "fall_history", "equals": "Yes" }
          },
          {
            "id": "fall_notes", "label": "Fall details", "type": "long_text", "width": "full", "hideInReport": true,
            "showIf": { "questionId": "fall_history", "equals": "Yes" }
          }
        ]
      },
      {
        "title": "Caring Plan",
        "reportTitle": "F. Caring Plan",
        "questions": [
          { "id": "caring_concern", "label": "Post-operative caring issue", "type": "multiple_choice", "width": "full", "options": [{ "value": "no concern", "label": "No concern" }, { "value": "some concerns", "label": "Some concerns", "detail": true, "detailPlaceholder": "remarks", "detailJoiner": ": " }], "reportTemplate": "Discussed with patient about caring issue after operation, reported {answer}." },
          { "id": "caring_plan", "label": "Caring plan", "type": "long_text", "width": "full", "placeholder": "Plan after operation" }
        ]
      },
      {
        "title": "Problem Identification",
        "reportTitle": "G. Problem Identification",
        "questions": [
          {
            "id": "problems", "label": "Problems", "type": "checkbox", "width": "full", "customReport": "problems_factors",
            "options": [
              { "value": "Patient factor", "subOptions": ["Impaired ADL function", "Impaired cognition", "Inadequate safety awareness", "Risk of fall", "Psychological distress", "Symptom distress (e.g. pain)", "NAD" ], "subAllowOther": true },
              { "value": "Environmental factor", "subOptions": ["Limited accessibility", "Risky home environment", "NAD" ], "subAllowOther": true },
              { "value": "Social factor", "subOptions": ["Lack of competent caregiver", "Inadequate social support", "Lives alone", "Daytime alone", "NAD" ], "subAllowOther": true }
            ], "allowOther": true
          }
        ]
      },
      {
        "title": "Recommendation",
        "reportTitle": "H. Recommendation",
        "questions": [
          { "id": "treatment", "label": "Treatment", "type": "checkbox", "width": "full", "reportTemplate": "Treatment:\n{answer}", "options": ["ADL Assessment and Training", "Cognitive Assessment and Training", "Reality Orientation", "Pain Management", "Stress Management / Relaxation Techniques", "Home safety advice / intervention", "Functional enhancement / maintenance", "Home-based training education", { "value": "Discharge planning", "detail": true, "detailPlaceholder": "input" }, { "value": "Pre- / Post-discharge home visit", "detail": true, "detailPlaceholder": "input" }], "allowOther": true, "otherPlaceholder": "Others" },
          { "id": "treatment_plan", "label": "Treatment plan", "type": "checkbox", "width": "full", "reportTemplate": "Treatment plan:\n{answer}", "options": ["Post-op review", "ADL training", "Maintenance training", "Cognitive training / Reality orientation", "Pressure Injury prevention", "Functionally fit home"], "allowOther": true, "otherPlaceholder": "Others / remarks" }
        ]
      }
    ]
  }
}
